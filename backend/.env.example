# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database name (defaults to "iot_dashboard")
DB_NAME=iot_dashboard

# HTTP server port (defaults to 3000)
HTTP_PORT=3000

# MQTT broker host (defaults to broker.emqx.io)
MQTT_BROKER=broker.emqx.io

# MQTT broker port (defaults to 1883)
MQTT_PORT=1883
